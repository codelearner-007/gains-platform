# ── Schoology credentials ─────────────────────────────────────────────────────
# Preferred: per-school credential map (secrets live ONLY here, never in the DB
# or any backend payload). JSON object keyed by credential ref. A school resolves
# to an entry via its `credential_ref` (from scraper-config), falling back to its
# `short_name`, then to the "default" entry. KEYS ONLY BELOW — fill in real values
# in your local .env, never commit them.
#
# SCHOOLOGY_CREDENTIALS={"Athenian":{"username":"","password":"","consumer_key":"","consumer_secret":""},"default":{"username":"","password":"","consumer_key":"","consumer_secret":""}}
SCHOOLOGY_CREDENTIALS=

# Legacy flat single-identity credentials — used as the LAST-RESORT fallback when
# a school has no match in SCHOOLOGY_CREDENTIALS (and no "default" entry). All four
# must be set together to count as a usable fallback.
SCHOOLOGY_URL=
SCHOOLOGY_USERNAME=
SCHOOLOGY_PASSWORD=
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=

# Supabase Storage (service-role key — bypasses Storage RLS, matches backend)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Backend (Gains Platform) — config fetch + post-upload trigger
BACKEND_BASE_URL=
INGESTION_TRIGGER_SECRET=

# Optional: bounded parallelism across schools (default 2, hard cap 4)
SCRAPER_CONCURRENCY=

# Optional: local download directory override (default ./downloads)
DOWNLOAD_DIR=

# ── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error   (default info)
# `debug` adds per-attempt polling detail and full stack traces — use it when
# investigating a failed run, not for normal operation.
SCRAPER_LOG_LEVEL=info

# ── Run notifications ───────────────────────────────────────────────────────
# Who hears about every run. Comma, semicolon or whitespace separated.
# Leave EMPTY to disable email entirely (the run still logs normally).
SCRAPER_NOTIFY_EMAILS=

# Resend API key + verified sender. Both are required once SCRAPER_NOTIFY_EMAILS
# is set; if recipients are configured and these are not, the scraper logs an
# ERROR rather than silently sending nothing.
RESEND_API_KEY=
SCRAPER_NOTIFY_FROM=

# always (default) | failure   — "failure" suppresses OK/NO-DATA runs.
# FATAL and FAILED runs are always sent regardless of this setting.
SCRAPER_NOTIFY_ON=always
