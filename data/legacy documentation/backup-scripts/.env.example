# Copy this file to `.env` and fill in real values.
# This file is read by every backup-scripts/*.sh script.
#
# After the backup is done, DELETE the .env file (or move it into the
# encrypted bundle). It contains the SQL sa password.

# ── Azure ──────────────────────────────────────────────────────────────────
# Find with: az account list -o table  (after `az login`)
LEGACY_SUB_ID="f42fd3fb-b245-4ad0-db5e-638ddce500de"
LEGACY_RG="EdvancelsResourceGroup"
LEGACY_AKS="EdvancelsAKSCluster"

# Find with: az synapse workspace list -g $LEGACY_RG -o table
LEGACY_SYNAPSE="syn-oea-edls1"

# Find with: az storage account list -g $LEGACY_RG -o table
LEGACY_STORAGE_ACCT="stoeaedls1"

# Find with: az keyvault list -g $LEGACY_RG -o table
LEGACY_KV_OEA="kv-oea-edls1"
LEGACY_KV_LMS="kv-elslms-prod"

# ── MSSQL on AKS ──────────────────────────────────────────────────────────
# Pod name (usually "mssql-0"). Find with:
#   kubectl get pods -n production | grep mssql
MSSQL_NAMESPACE="production"
MSSQL_POD="mssql-0"

# The SA password. From gains legacy/EdvanceLearning/README.md.
# !! Rotate this password AFTER the backup finishes. !!
MSSQL_SA_PWD="REPLACE_ME"

# ── Local working directory ───────────────────────────────────────────────
# Where backups land. Auto-set to today's date if you leave it blank.
BACKUP_ROOT="$HOME/Desktop/PS_P"
