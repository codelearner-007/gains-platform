# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing artifacts
/coverage
/test-results
/tests/screenshots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore all except example templates
.env*
!.env.local.example
!.env.example

# vercel
.vercel

# typescript build artifacts (auto-generated, not for version control)
*.tsbuildinfo
next-env.d.ts

.env.local