# ============================================================
# Gains Platform Frontend — Environment Variables
# Copy to .env.local and fill in values before running.
# ============================================================

# ------------------------------------------------------------
# Supabase (local dev values shown — replace for production)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Supabase service role key — used only in Next.js API routes (never exposed to browser)
PRIVATE_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NEXT_PUBLIC_PRODUCTNAME=GAINS

# Public site URL — used for auth redirects and email links.
# Local dev: http://localhost:3000 ; production: the deployed frontend URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI backend URL — used in Server Components that cannot use /api/v1 rewrites
# Leave as default for local dev; point to your deployed backend in production.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: Google Analytics measurement id (analytics off when empty).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Comma-separated SSO providers exposed in the UI. Provider must also be enabled
# in supabase/config.toml AND have credentials configured. Supported: google
NEXT_PUBLIC_SSO_PROVIDERS=google

# Google sign-in client id. When empty, the Google button is hidden entirely.
# Set this only once real Google credentials are configured.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# LTI 1.3 session bridge (only when LTI is enabled on the backend)
# ------------------------------------------------------------
# Shared secret the bridge (/api/lti/bridge) sends to the backend's machine-auth
# /api/v1/lti/consume-ticket. MUST equal the backend LTI_BRIDGE_SECRET. Unset →
# the bridge fails CLOSED (redirects to login). Never commit a value.
LTI_BRIDGE_SECRET=
# Where the bridge lands the browser after minting the session. Optional; the
# bridge defaults to /app (the dashboard), which is the intended framed landing.
# Leave unset or /app so Schoology launches open on the dashboard.
LTI_REDIRECT_BASE=/app
