# ============================================================
# Starter Template Frontend — Environment Variables
# Copy to .env.local and fill in values before running.
# ============================================================

# ------------------------------------------------------------
# Supabase (local dev values shown — replace for production)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Supabase service role key — used only in Next.js API routes (never exposed to browser)
PRIVATE_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NEXT_PUBLIC_PRODUCTNAME=Starter Template

# FastAPI backend URL — used in Server Components that cannot use /api/v1 rewrites
# Leave as default for local dev; point to your deployed backend in production.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------
# Redis (Next.js API route rate limiting — e.g. GET /api/auth/me)
# Without FRONTEND_REDIS_URL, limits are skipped when FRONTEND_RATE_LIMIT_FAIL_OPEN=true.
# ------------------------------------------------------------
FRONTEND_REDIS_URL=redis://127.0.0.1:6379/1
FRONTEND_REDIS_PREFIX=starter_template
FRONTEND_RATE_LIMIT_AUTH_ME=60/minute
FRONTEND_RATE_LIMIT_ENABLED=true
FRONTEND_RATE_LIMIT_FAIL_OPEN=true
