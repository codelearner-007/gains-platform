# ============================================================
# Gains Platform Backend — Environment Variables
# Copy to .env and fill in values before running.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------
# Supabase (local dev values shown — replace for production)
# ------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# JWT secret — must match Supabase project JWT secret
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# JWT decoding settings (leave defaults for Supabase)
USE_JWKS=true
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Public URL of the frontend app
APP_BASE_URL=http://localhost:3000

ENVIRONMENT=development
LOG_LEVEL=INFO

# Seeding / RLS defaults
GAINS_SUPERADMIN_EMAIL=
DEFAULT_SCHOOL_BUILDING_ID=186370968

# ------------------------------------------------------------
# LTI 1.3 — disabled by default (routes hidden while dormant)
# ------------------------------------------------------------
LTI_ENABLED=false
# Only used when LTI is enabled:
PUBLIC_BASE_URL=http://localhost:3000
LTI_REDIRECT_BASE=/app/reports/standard-summary

# ------------------------------------------------------------
# Schoology ingestion (scraper → Supabase Storage → worker)
# PROD stays serving-only: leave TRANSFORMS_ENABLED=false there so a rebuild can
# never empty its zero-raw warehouse. The LOCAL full-raw box is the rebuild
# machine → set INGESTION_SOURCE=supabase and INGESTION_TRANSFORMS_ENABLED=true.
# ------------------------------------------------------------
# Blob source for run_ingestion: local (filesystem) | supabase (Storage) | azure (legacy)
# NOTE: this + the other raw vars below (DEFAULT_SCHOOL_BUILDING_ID,
# GAINS_SUPERADMIN_EMAIL, INGESTION_DB_*) are read straight from the PROCESS
# environment (not pydantic .env). On a deploy they come from the platform; for
# local you must export them into the shell (or your run must load .env into env).
INGESTION_SOURCE=local
INGESTION_STORAGE_BUCKET=schoology-ingest
# Shared secret for the machine-auth scraper endpoints (X-Ingestion-Secret).
# Empty → the trigger endpoint fails CLOSED (401). Must match the scraper's value.
INGESTION_TRIGGER_SECRET=
# Transform kill-switch: false on prod (never rebuild), true on the local rebuild box.
INGESTION_TRANSFORMS_ENABLED=false
# Durable worker loop (started in the FastAPI lifespan; never under pytest).
INGESTION_WORKER_ENABLED=true
INGESTION_WORKER_POLL_SECONDS=15
INGESTION_LEASE_SECONDS=180
INGESTION_HEARTBEAT_SECONDS=30
INGESTION_MAX_ATTEMPTS=3
# Empty-raw floor: refuse a rebuild when raw is below this (catches raw=0).
INGESTION_RAW_FLOOR=1000
# Separate pool the ingestion/transform jobs use (jobs/db.py).
INGESTION_DB_POOL_SIZE=5
INGESTION_DB_MAX_OVERFLOW=5

# ------------------------------------------------------------
# Redis (optional in dev; required when Redis features enabled)
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=starter_template
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
# Defaults: enabled in production when unset
REDIS_ENABLE_RATE_LIMIT_STORAGE=false
REDIS_ENABLE_SHARE_SESSIONS=false

# ------------------------------------------------------------
# Rate limiting (slowapi syntax)
# ------------------------------------------------------------
RATE_LIMIT_AUTH_ME=60/minute
RATE_LIMIT_USER_ROLES_ASSIGN=30/minute
RATE_LIMIT_USER_ROLES_REMOVE=30/minute
# Report XLSX export is CPU/memory heavy — cap it below the read endpoints.
RATE_LIMIT_REPORTS_EXPORT=20/minute

# ------------------------------------------------------------
# CORS (disabled by default — not needed when using Next.js rewrites)
# ------------------------------------------------------------
ENABLE_CORS=false
ALLOWED_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------
# OAuth providers — read by Supabase via supabase/config.toml.
# Set these in your local environment (NOT in supabase/.env which is
# committed); Supabase CLI also picks them up at start.
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: <SUPABASE_URL>/auth/v1/callback
# ------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
