# ============================================================
# Gains Platform Backup Service — Environment Variables
# Copy to .env and fill in values before running.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Supabase Supavisor SESSION-mode pooler connection string. NOT the direct
# db.<ref>.supabase.co host (IPv6-only since Jan 2024 — unreachable from
# Railway's IPv4 containers without the paid IPv4 add-on) and NOT the
# port-6543 transaction-mode pooler (breaks pg_dump's COPY semantics under
# shared backend connections). Get the exact string from Supabase Dashboard
# -> Project Settings -> Database -> Connection string -> "Session pooler".
# Still port 5432, different hostname than the direct connection. Required.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres

# ------------------------------------------------------------
# Cloudflare R2
# ------------------------------------------------------------
# Cloudflare account ID; used to build the R2 endpoint URL
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com. Required.
R2_ACCOUNT_ID=
# R2 API token access key ID, scoped to Object Read & Write on the single
# target bucket only (not account-wide Admin Read & Write). Required.
R2_ACCESS_KEY_ID=
# The matching secret for R2_ACCESS_KEY_ID. Required.
R2_SECRET_ACCESS_KEY=
# Target bucket name. Required.
R2_BUCKET=
# Key prefix backups are written under. Must match the prefix scoped by the
# R2 bucket's Object Lifecycle Rule exactly, including the trailing slash, or
# old backups will not auto-expire. Optional, default shown.
R2_BACKUP_PREFIX=backups/
# How many most-recent backups to keep in R2, enforced by the app (not the
# R2 lifecycle rule) -- after every successful run, the oldest backup(s)
# beyond this count are deleted. A value of 0 is treated as 1 (the
# just-uploaded backup is never deleted). Optional, default shown.
BACKUP_RETENTION_COUNT=3

# ------------------------------------------------------------
# Backup behavior
# ------------------------------------------------------------
# Hard wall-clock limit on the pg_dump step before it is killed (ms). Exists
# specifically to bound the "hung job blocks tomorrow's cron trigger" risk —
# Railway skips a scheduled run outright if the previous one is still running.
# Optional, default shown (30 min).
BACKUP_PGDUMP_TIMEOUT_MS=1800000
# Hard wall-clock limit on the R2 upload step before the script gives up
# waiting on it (ms). Same rationale as above. Optional, default shown (20 min).
BACKUP_UPLOAD_TIMEOUT_MS=1200000
# Local scratch directory for the dump file before upload. Optional, default
# is the OS temp dir (tempfile.gettempdir()) when left unset.
BACKUP_TMP_DIR=

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# debug | info | warning | error. Optional, default shown.
BACKUP_LOG_LEVEL=info

# ------------------------------------------------------------
# Run notifications (Resend)
# ------------------------------------------------------------
# Who hears about every run. Comma/semicolon/whitespace separated. Empty
# disables email entirely (the run still logs normally).
BACKUP_NOTIFY_EMAILS=
# Resend API key. Required once BACKUP_NOTIFY_EMAILS is set.
RESEND_API_KEY=
# Verified Resend sender address. Required once BACKUP_NOTIFY_EMAILS is set.
BACKUP_NOTIFY_FROM=
# always (default) sends every run's summary; failure suppresses OK runs
# (FATAL and FAILED runs always send regardless of this setting).
BACKUP_NOTIFY_ON=always
